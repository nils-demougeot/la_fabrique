# ───────────────────────────────────────────────────────────────────────────
# Exemple de configuration. Copier en `.env` (jamais commité) et remplir.
# En production (Render), renseigner ces valeurs dans les variables d'environnement.
# ───────────────────────────────────────────────────────────────────────────

# Mode debug. False (ou absent) en production. True uniquement en local.
DJANGO_DEBUG=False

# OBLIGATOIRE en production. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Domaines autorisés, séparés par des virgules (sans https://).
# Render fournit aussi RENDER_EXTERNAL_HOSTNAME automatiquement.
DJANGO_ALLOWED_HOSTS=la-fabrique.onrender.com

# Base de données. Laisser vide en local pour utiliser SQLite.
DATABASE_URL=

# Stockage cloud des images (prod). Format :
#   cloudinary://api_key:api_secret@cloud_name
# Laisser vide pour le stockage local (dev).
CLOUDINARY_URL=

# Création automatique du superuser au déploiement (build.sh).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
